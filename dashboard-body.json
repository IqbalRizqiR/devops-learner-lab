{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Invocations",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "devops-user-api"],
          ["AWS/Lambda", "Invocations", "FunctionName", "devops-order-api"],
          ["AWS/Lambda", "Invocations", "FunctionName", "devops-notif-worker"],
          ["AWS/Lambda", "Invocations", "FunctionName", "devops-websocket-api"]
        ],
        "period": 60,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Errors",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "devops-user-api"],
          ["AWS/Lambda", "Errors", "FunctionName", "devops-order-api"],
          ["AWS/Lambda", "Errors", "FunctionName", "devops-notif-worker"],
          ["AWS/Lambda", "Errors", "FunctionName", "devops-websocket-api"]
        ],
        "period": 60,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Duration (p50 / p99) - user-api & order-api",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "devops-user-api", { "stat": "p50", "label": "user-api p50" }],
          ["AWS/Lambda", "Duration", "FunctionName", "devops-user-api", { "stat": "p99", "label": "user-api p99" }],
          ["AWS/Lambda", "Duration", "FunctionName", "devops-order-api", { "stat": "p50", "label": "order-api p50" }],
          ["AWS/Lambda", "Duration", "FunctionName", "devops-order-api", { "stat": "p99", "label": "order-api p99" }]
        ],
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "RDS CPU Utilization",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/RDS", "CPUUtilization", "DBInstanceIdentifier", "devops-db"]
        ],
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "RDS Database Connections",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", "devops-db"]
        ],
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "SQS Messages Visible",
        "view": "bar",
        "stacked": false,
        "region": "us-west-2",
        "metrics": [
          ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "devops-dlq"],
          ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "devops-orders-queue"],
          ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "devops-notifications-queue"]
        ],
        "period": 60,
        "stat": "Average"
      }
    }
  ]
}
